rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /user_backups/{uid}/snapshots/{snapshotId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /chunks/{chunkId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
